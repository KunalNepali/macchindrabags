@{
    var pageTitle = ViewData["Title"] as string
                     ?? "New Macchindra Leather & Bag Store | Bag Repair in Lagankhel";

    var pageDescription = ViewData["Description"] as string
                           ?? "New Macchindra Leather and Bag Store in Lagankhel, Lalitpur. Professional bag repair, luggage repair, leather care and quality bags.";

    var canonicalUrl = $"https://newmacchindrabagstore.onrender.com{Context.Request.Path}";

    var ogType = ViewData["OgType"] as string ?? "website";

    var ogImagePath = ViewData["OgImage"] as string
                      ?? "/images/brand/a_logo_ssb.png";

    var socialImage = $"https://newmacchindrabagstore.onrender.com{ogImagePath}";

    var articlePublishedDate = ViewData["ArticlePublishedDate"] as string;

    var articleCategory = ViewData["ArticleCategory"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>@pageTitle</title>

    <meta name="description"
          content="@pageDescription" />

    <meta name="robots"
          content="index, follow" />

    <link rel="canonical"
          href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
<meta property="og:type"
      content="@ogType" />

    <meta property="og:title"
          content="@pageTitle" />

    <meta property="og:description"
          content="@pageDescription" />

    <meta property="og:url"
          content="@canonicalUrl" />

    <meta property="og:image"
          content="@socialImage" />

    <meta property="og:image:alt"
          content="New Macchindra Leather & Bag Store" />

    <meta property="og:site_name"
          content="New Macchindra Leather & Bag Store" />

    <!-- Twitter / X -->
    <meta name="twitter:card"
          content="summary_large_image" />

    <meta name="twitter:title"
          content="@pageTitle" />

    <meta name="twitter:description"
          content="@pageDescription" />

    <meta name="twitter:image"
          content="@socialImage" />

    <meta name="twitter:image:alt"
          content="New Macchindra Leather & Bag Store" />

    <!-- Favicon -->
    <link rel="icon"
          type="image/png"
          href="~/images/brand/a_logo_ssb.png" />

    <!-- Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <!-- Main stylesheet -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Local Business Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "LocalBusiness",
        "@@id": "https://newmacchindrabagstore.onrender.com/#business",

        "name": "New Macchindra Leather & Bag Store",

        "url": "https://newmacchindrabagstore.onrender.com/",

        "logo": "https://newmacchindrabagstore.onrender.com/images/brand/a_logo_ssb.png",

        "image": "https://newmacchindrabagstore.onrender.com/images/brand/a_logo_ssb.png",

        "telephone": [
            "+9779860357158",
            "+9779841821074"
        ],

        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Lagankhel",
            "addressRegion": "Lalitpur",
            "addressCountry": "NP"
        },

        "areaServed": {
            "@@type": "City",
            "name": "Lalitpur"
        },

        "sameAs": [
            "https://www.instagram.com/new.macchindra.bag.store/",
            "https://www.tiktok.com/@@new.macchindra.bag.store",
            "https://www.facebook.com/profile.php?id=100084688467592"
        ]
    }
    </script>
    @if (ogType == "article")
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BlogPosting",

        "headline": "@Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageTitle).Trim('"'))",

        "description": "@Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageDescription).Trim('"'))",

        "image": [
            "@socialImage"
        ],

        "url": "@canonicalUrl",

        "datePublished": "@articlePublishedDate",

        "author": {
            "@@type": "Organization",
            "name": "New Macchindra Leather & Bag Store",
            "url": "https://newmacchindrabagstore.onrender.com/"
        },

        "publisher": {
            "@@type": "Organization",
            "name": "New Macchindra Leather & Bag Store",
            "url": "https://newmacchindrabagstore.onrender.com/",
            "logo": {
                "@@type": "ImageObject",
                "url": "https://newmacchindrabagstore.onrender.com/images/brand/a_logo_ssb.png"
            }
        },

        "mainEntityOfPage": {
            "@@type": "WebPage",
            "@@id": "@canonicalUrl"
        }
    }
    </script>
}
</head>

<body>
    <header class="site-header" id="siteHeader">
        <nav class="navbar container">

<a class="brand" href="/#home">
                <img src="~/images/brand/a_logo_ssb.png"
                     alt="New Macchindra Leather and Bag Store logo" />

                <div class="brand-text">
                    <strong>New Macchindra</strong>
                    <span>Leather & Bag Store</span>
                </div>
            </a>

            <button class="menu-toggle"
                    id="menuToggle"
                    aria-label="Open menu"
                    type="button">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="nav-links" id="navLinks">

<a href="/#home">Home</a>

<a href="/#services">Services</a>

<a href="/#repairs">Our Work</a>

<a href="/#products">Products</a>

<a href="/blog">Blog</a>

<a href="/#social">Social</a>

<a href="/#contact">Contact</a>

                <div class="nav-socials">

                    <a href="https://www.tiktok.com/@@new.macchindra.bag.store"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="TikTok">
                        TT
                    </a>

                    <a href="https://www.instagram.com/new.macchindra.bag.store/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Instagram">
                        IG
                    </a>

                    <a href="https://www.facebook.com/profile.php?id=100084688467592"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Facebook">
                        FB
                    </a>

                </div>

                <a class="nav-call"
                   href="tel:9860357158">
                    Call Us
                </a>

            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">

        <div class="container footer-inner">

            <div class="footer-main">

                <div class="footer-brand">
                    New Macchindra Leather & Bag Store
                </div>

                <p>
                    Professional bag, leather and luggage repair
                    service in Lagankhel, Lalitpur.
                </p>

                <div class="footer-socials">

                    <a href="https://www.tiktok.com/@@new.macchindra.bag.store"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span>TT</span>
                        TikTok

                    </a>

                    <a href="https://www.instagram.com/new.macchindra.bag.store/"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span>IG</span>
                        Instagram

                    </a>

                    <a href="https://www.facebook.com/profile.php?id=100084688467592"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span>FB</span>
                        Facebook

                    </a>

                </div>

            </div>

            <div class="footer-contact">

                <strong>Contact</strong>

                <a href="tel:9860357158">
                    9860357158
                </a>

                <a href="tel:9841821074">
                    9841821074
                </a>

                <span>
                    Lagankhel, Lalitpur
                </span>

            </div>

            <div class="footer-services">

                <strong>Our Services</strong>

                <span>Bag Repair</span>
                <span>Luggage Repair</span>
                <span>Leather Care</span>
                <span>New Bags & Accessories</span>

            </div>

        </div>

        <div class="footer-bottom">

            <div class="container footer-bottom-inner">

                <span>
                    © @DateTime.Now.Year New Macchindra Leather & Bag Store.
                    All rights reserved.
                </span>

                <span>
                    Lagankhel, Lalitpur
                </span>

            </div>

        </div>

    </footer>

    <div class="mobile-contact-bar">

        <a href="tel:9860357158">
            <span>☎</span>
            Call
        </a>

        <a href="https://wa.me/9779860357158"
           target="_blank"
           rel="noopener noreferrer">

            <span>◉</span>
            WhatsApp

        </a>

    </div>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>