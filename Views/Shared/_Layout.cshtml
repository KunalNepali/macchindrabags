<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - New Macchindra Leather & Bag Store</title>

    <meta name="description"
          content="New Macchindra Leather and Bag Store in Lagankhel, Lalitpur. Professional bag repair, luggage repair, leather polishing, handle, zip, wheel and stitching services. New bags available for online order and delivery." />

    <meta name="keywords"
          content="bag repair Lagankhel, luggage repair Lalitpur, leather repair Nepal, bag store Lalitpur, luggage repair, ladies bag repair, school bag repair" />

    <link rel="icon"
          type="image/png"
          href="~/images/brand/a_logo_ssb.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =========================
         NAVBAR
    ========================== -->

    <header class="site-header" id="siteHeader">

        <nav class="navbar container">

            <a class="brand" href="#home">

                <img src="~/images/brand/a_logo_ssb.png"
                     alt="New Macchindra Leather and Bag Store logo" />

                <div class="brand-text">
                    <strong>New Macchindra</strong>
                    <span>Leather & Bag Store</span>
                </div>

            </a>


            <button class="menu-toggle"
                    id="menuToggle"
                    aria-label="Open menu"
                    type="button">

                <span></span>
                <span></span>
                <span></span>

            </button>


            <div class="nav-links" id="navLinks">

                <a href="#home">Home</a>

                <a href="#services">Services</a>

                <a href="#repairs">Our Work</a>

                <a href="#products">Products</a>

                <a href="#social">Social</a>

                <a href="#contact">Contact</a>


                <div class="nav-socials">

                    <a href="https://www.tiktok.com/@@new.macchindra.bag.store"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="TikTok">
                        TT
                    </a>

                    <a href="https://www.instagram.com/new.macchindra.bag.store/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Instagram">
                        IG
                    </a>

                    <a href="https://www.facebook.com/profile.php?id=100084688467592"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Facebook">
                        FB
                    </a>

                </div>


                <a class="nav-call" href="tel:9860357158">
                    Call Us
                </a>

            </div>

        </nav>

    </header>


    <!-- =========================
         PAGE CONTENT
    ========================== -->

    <main>
        @RenderBody()
    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="footer">

        <div class="container footer-inner">


            <div class="footer-main">

                <div class="footer-brand">
                    New Macchindra Leather & Bag Store
                </div>

                <p>
                    Professional bag, leather and luggage repair
                    service in Lagankhel, Lalitpur.
                </p>


                <div class="footer-socials">

                    <a href="https://www.tiktok.com/@@new.macchindra.bag.store"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span>TT</span>
                        TikTok

                    </a>


                    <a href="https://www.instagram.com/new.macchindra.bag.store/"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span>IG</span>
                        Instagram

                    </a>


                    <a href="https://www.facebook.com/profile.php?id=100084688467592"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span>FB</span>
                        Facebook

                    </a>

                </div>

            </div>


            <div class="footer-contact">

                <strong>Contact</strong>

                <a href="tel:9860357158">
                    9860357158
                </a>

                <a href="tel:9841821074">
                    9841821074
                </a>

                <span>
                    Lagankhel, Lalitpur
                </span>

            </div>


            <div class="footer-services">

                <strong>Our Services</strong>

                <span>Bag Repair</span>

                <span>Luggage Repair</span>

                <span>Leather Care</span>

                <span>New Bags & Accessories</span>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="container footer-bottom-inner">

                <span>
                    © @DateTime.Now.Year New Macchindra Leather & Bag Store.
                    All rights reserved.
                </span>

                <span>
                    Lagankhel, Lalitpur
                </span>

            </div>

        </div>

    </footer>


    <!-- =========================
         MOBILE CONTACT BAR
    ========================== -->

    <div class="mobile-contact-bar">

        <a href="tel:9860357158">

            <span>☎</span>

            Call

        </a>


        <a href="https://wa.me/9779860357158"
           target="_blank"
           rel="noopener noreferrer">

            <span>◉</span>

            WhatsApp

        </a>

    </div>


    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>